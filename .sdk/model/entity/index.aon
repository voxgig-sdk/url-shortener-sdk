# Entity: index

main: kit: entity: index: {

  alias: field: {}

  fields: [
    {
      name: "C"
      req: false
      short: "Status type: G for information, R for error."
      type: "`$STRING`"
    }
    {
      name: "M"
      req: false
      short: "Server message (present on error)."
      type: "`$STRING`"
    }
    {
      name: "code"
      req: false
      short: "The shortened URL (present on success)."
      type: "`$STRING`"
    }
  ]

  name: "index"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "https://google.com"
                kind: "query"
                name: "url"
                orig: "url"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/set/index.php"
          parts: [
            "api"
            "set"
            "index.php"
          ]
          select: {
            exist: [
              "url"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
